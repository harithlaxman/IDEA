# Copy to .env and fill in. .env is git-ignored; this file is not — no secrets here.

# --- Required ---------------------------------------------------------------

ANTHROPIC_API_KEY=sk-ant-...

# Signs session JWTs and the session cookie. No default; the app refuses to
# start without it. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Host must be reachable from wherever the app runs: localhost for `uvicorn`,
# `db` for the compose Postgres, `host.docker.internal` for a host Postgres
# seen from a container. The bundled compose Postgres is postgres:idea.
MAIN_DATABASE_URL=postgresql://postgres:idea@localhost:5432/idea_main
IPEDS_DATABASE_URL=postgresql://postgres:idea@localhost:5432/idea_ipeds

# --- Local development ------------------------------------------------------

# Email-box login instead of Google OAuth. Never set in a deployed environment.
DEV_AUTH_BYPASS=1
# Browsers drop Secure cookies over plain http, so login fails silently with 1.
COOKIE_SECURE=0

# --- Optional: agent tuning -------------------------------------------------

# AGENT_MODEL=anthropic:claude-sonnet-4-5
# CHECKPOINT_DATABASE_URL=            # defaults to MAIN_DATABASE_URL
# CONTEXT_WINDOW=200000
# CLEAR_TOOL_USES_TRIGGER=30000
# RECURSION_LIMIT=50

# --- Optional: Google OAuth (production sign-in) ----------------------------

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# --- Optional: db_setup/postprocess*.py (Azure OpenAI) ----------------------

# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=               # AZURE_OPENAI_KEY also accepted
# AZURE_OPENAI_DEPLOYMENT_NAME=
# AZURE_OPENAI_API_VERSION=           # defaults to a recent stable version

# --- Optional: eval/run_eval.py ---------------------------------------------

# LANGSMITH_API_KEY=
